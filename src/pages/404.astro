---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout title="404 — ember.vecnet.ai" description="Memory sector corrupted.">
  <div class="text-center py-24">
    <h1 class="font-mono text-6xl font-medium mb-4 text-[#f97316]">404</h1>
    <p class="font-mono text-xl text-[#a1a1aa] mb-8">Memory sector corrupted. Data not found.</p>
    <a href="/" class="font-mono text-sm border border-[#27272a] px-4 py-2 hover:border-[#f97316] hover:text-[#f97316] transition-colors">
      [Return to Index]
    </a>
  </div>
</BaseLayout>
